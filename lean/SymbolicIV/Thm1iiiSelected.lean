import Mathlib

/-!
# Theorem 1(iii), step 2 (THEORY.md §3, proof of Theorem 1(iii)): the selected-tree independence step

The paper's display: with `ŝ` the tree selected on the A sample, `S_B(s)` the studentized
statistic computed on the B sample for the fixed tree `s`, `N` the limit law and `φ` bounded,

  `|E φ(S_B(ŝ)) − E φ(N)| ≤ ∑_{s ∈ S₀^min} P(ŝ = s) |E φ(S_B(s)) − E φ(N)| + 2‖φ‖_∞ P(ŝ ∉ S₀^min)`,

using `E[φ(S_B(s)) 1{ŝ = s}] = P(ŝ = s) E[φ(S_B(s))]`, which holds because `ŝ` is a function of
A and A is independent of B.

Formalized here:
* `integral_indicator_mul_of_indep` : the independence identity
  `∫ 1_A · Y = P(A) ∫ Y` for `A` measurable in `𝓐`, `Y` bounded measurable in `𝓑`, `Indep 𝓐 𝓑 P`.
* `integral_selected_eq_sum` : `E φ(X_ŝ) = ∑_s P(ŝ = s) E φ(X_s)`.
* `selected_tree_bound` (main) : the displayed inequality, for an arbitrary finite set `Smin`.

## Modelling and hypotheses added beyond the paper

* `Ω` carries a probability measure `P` on an ambient σ-algebra `m0`; `𝓐, 𝓑 ≤ m0` are the
  σ-algebras generated by the A sample (with any search randomization independent of the data, which the paper allows) and by the B sample, with `Indep 𝓐 𝓑 P` (the paper's "A is independent
  of B because the split does not depend on the data").
* Trees form a finite type `S`; the selector `ŝ : Ω → S` is `𝓐`-measurable in the form
  `∀ s, MeasurableSet[𝓐] (ŝ ⁻¹' {s})` (equivalent to measurability for a finite `S`).
* The per-tree statistic `X s : Ω → E` (the paper's `S_B(s)`, valued in `ℝ^{p₀}`) is
  `𝓑`-measurable for each `s`; `E` is any measurable space (the first version of this file took
  `E = ℝ`; nothing in the argument depends on the codomain).
* `φ : E → ℝ` is measurable with `|φ x| ≤ M` for all `x` (the paper takes `φ` bounded
  continuous on `ℝ^{p₀}`; continuity is not needed for this step, `M` plays the role of `‖φ‖_∞`).
* `c` is the paper's `E φ(N)`; the hypothesis `|c| ≤ M` is what `c = E φ(N)` and `|φ| ≤ M`
  give, and it is needed: without it the tail term `2M P(ŝ ∉ Smin)` is not enough.
* Probabilities are written `P.real E = (P E).toReal`.
-/

open MeasureTheory ProbabilityTheory

namespace SymbolicIV.Thm1iii

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {P : Measure Ω} {E : Type*} [MeasurableSpace E]

/-- Independence identity: for `A ∈ 𝓐` and `Y` bounded `𝓑`-measurable, `E[1_A Y] = P(A) E[Y]`. -/
theorem integral_indicator_mul_of_indep (𝓐 𝓑 : MeasurableSpace Ω) (h𝓐 : 𝓐 ≤ m0) (h𝓑 : 𝓑 ≤ m0)
    (hind : Indep 𝓐 𝓑 P) {A : Set Ω} (hA : MeasurableSet[𝓐] A) {Y : Ω → ℝ}
    (hY : Measurable[𝓑] Y) :
    ∫ ω, A.indicator Y ω ∂P = P.real A * ∫ ω, Y ω ∂P := by
  -- the indicator of `A` (as a real function) and `Y` are independent random variables
  have hI : IndepFun (A.indicator (1 : Ω → ℝ)) Y P := by
    rw [indepFun_iff_measure_inter_preimage_eq_mul]
    intro s t hs ht
    have h1 : MeasurableSet[𝓐] (A.indicator (1 : Ω → ℝ) ⁻¹' s) :=
      (measurable_const.indicator hA) hs
    have h2 : MeasurableSet[𝓑] (Y ⁻¹' t) := hY ht
    exact (hind.indepSet_of_measurableSet h1 h2).measure_inter_eq_mul
  have hA0 : MeasurableSet[m0] A := h𝓐 _ hA
  have hY0 : Measurable[m0] Y := hY.mono h𝓑 le_rfl
  have hI0 : Measurable[m0] (A.indicator (1 : Ω → ℝ)) := measurable_const.indicator hA0
  have heq : (fun ω => A.indicator Y ω) = fun ω => A.indicator (1 : Ω → ℝ) ω * Y ω := by
    funext ω
    by_cases h : ω ∈ A <;> simp [Set.indicator, h]
  rw [heq, hI.integral_fun_mul_eq_mul_integral hI0.aestronglyMeasurable hY0.aestronglyMeasurable,
    integral_indicator_one hA0]

variable [IsProbabilityMeasure P] {S : Type*} [Fintype S]

/-- A function of the selected index is the sum over indices of indicator-weighted terms. -/
theorem apply_selected_eq_sum (ŝ : Ω → S) (Y : S → Ω → ℝ) (ω : Ω) :
    Y (ŝ ω) ω = ∑ s, (ŝ ⁻¹' {s}).indicator (Y s) ω := by
  rw [Finset.sum_eq_single (ŝ ω)]
  · simp [Set.indicator]
  · intro b _ hb
    simp [Set.indicator, Ne.symm hb]
  · intro h; exact absurd (Finset.mem_univ _) h

/-- Integrability of a bounded measurable function on a probability space. -/
theorem integrable_of_bounded_measurable {Y : Ω → ℝ} (hY : Measurable Y) {M : ℝ}
    (hM : ∀ ω, |Y ω| ≤ M) : Integrable Y P :=
  Integrable.of_bound hY.aestronglyMeasurable M (Filter.Eventually.of_forall fun ω => by
    simpa [Real.norm_eq_abs] using hM ω)

/-- `E φ(X_ŝ) = ∑_s P(ŝ = s) E φ(X_s)` (THEORY.md §3, the identity the display of step 2 rests on). -/
theorem integral_selected_eq_sum (𝓐 𝓑 : MeasurableSpace Ω) (h𝓐 : 𝓐 ≤ m0) (h𝓑 : 𝓑 ≤ m0)
    (hind : Indep 𝓐 𝓑 P) (ŝ : Ω → S) (hŝ : ∀ s, MeasurableSet[𝓐] (ŝ ⁻¹' {s}))
    (X : S → Ω → E) (hX : ∀ s, Measurable[𝓑] (X s)) (φ : E → ℝ) (hφ : Measurable φ) (M : ℝ)
    (hM : ∀ x, |φ x| ≤ M) :
    ∫ ω, φ (X (ŝ ω) ω) ∂P = ∑ s, P.real (ŝ ⁻¹' {s}) * ∫ ω, φ (X s ω) ∂P := by
  have h1 : (fun ω => φ (X (ŝ ω) ω)) =
      fun ω => ∑ s, (ŝ ⁻¹' {s}).indicator (fun ω => φ (X s ω)) ω := by
    funext ω
    exact apply_selected_eq_sum ŝ (fun s ω => φ (X s ω)) ω
  rw [h1, integral_finsetSum]
  · refine Finset.sum_congr rfl fun s _ => ?_
    exact integral_indicator_mul_of_indep 𝓐 𝓑 h𝓐 h𝓑 hind (hŝ s) (hφ.comp (hX s))
  · intro s _
    have hm : Measurable[m0] (fun ω => φ (X s ω)) := (hφ.comp (hX s)).mono h𝓑 le_rfl
    have hs0 : MeasurableSet[m0] (ŝ ⁻¹' {s}) := h𝓐 _ (hŝ s)
    exact (integrable_of_bounded_measurable (P := P) hm (M := M) fun ω => hM _).indicator hs0

variable [DecidableEq S]

/-- Theorem 1(iii), step 2 (THEORY.md §3, proof of Theorem 1(iii)): the selected-tree bound. -/
theorem selected_tree_bound (𝓐 𝓑 : MeasurableSpace Ω) (h𝓐 : 𝓐 ≤ m0) (h𝓑 : 𝓑 ≤ m0)
    (hind : Indep 𝓐 𝓑 P) (ŝ : Ω → S) (hŝ : ∀ s, MeasurableSet[𝓐] (ŝ ⁻¹' {s}))
    (X : S → Ω → E) (hX : ∀ s, Measurable[𝓑] (X s)) (φ : E → ℝ) (hφ : Measurable φ) (M : ℝ)
    (hM : ∀ x, |φ x| ≤ M) (c : ℝ) (hc : |c| ≤ M) (Smin : Finset S) :
    |(∫ ω, φ (X (ŝ ω) ω) ∂P) - c| ≤
      ∑ s ∈ Smin, P.real (ŝ ⁻¹' {s}) * |(∫ ω, φ (X s ω) ∂P) - c|
        + 2 * M * P.real (ŝ ⁻¹' (Finset.univ.filter (fun s => s ∉ Smin) : Finset S)) := by
  -- probabilities of the fibres
  set p : S → ℝ := fun s => P.real (ŝ ⁻¹' {s}) with hp
  have hp0 : ∀ s, 0 ≤ p s := fun s => measureReal_nonneg
  have hmeas : ∀ s, MeasurableSet[m0] (ŝ ⁻¹' {s}) := fun s => h𝓐 _ (hŝ s)
  have hsum : ∀ T : Finset S, ∑ s ∈ T, p s = P.real (ŝ ⁻¹' (T : Set S)) := fun T =>
    sum_measureReal_preimage_singleton T (fun s _ => hmeas s)
  have hsum1 : ∑ s, p s = 1 := by
    rw [hsum Finset.univ]; simp
  -- the identity of `integral_selected_eq_sum`
  set I : S → ℝ := fun s => ∫ ω, φ (X s ω) ∂P with hI
  have hIb : ∀ s, |I s| ≤ M := by
    intro s
    calc |I s| = ‖∫ ω, φ (X s ω) ∂P‖ := by rw [Real.norm_eq_abs]
      _ ≤ M * P.real Set.univ := by
        refine norm_integral_le_of_norm_le_const ?_
        exact Filter.Eventually.of_forall fun ω => by simpa [Real.norm_eq_abs] using hM _
      _ = M := by simp
  have hdiff : ∀ s, |I s - c| ≤ 2 * M := by
    intro s
    calc |I s - c| ≤ |I s| + |c| := abs_sub _ _
      _ ≤ M + M := add_le_add (hIb s) hc
      _ = 2 * M := by ring
  have hmain : (∫ ω, φ (X (ŝ ω) ω) ∂P) - c = ∑ s, p s * (I s - c) := by
    rw [integral_selected_eq_sum 𝓐 𝓑 h𝓐 h𝓑 hind ŝ hŝ X hX φ hφ M hM]
    show ∑ s, p s * I s - c = _
    simp only [mul_sub, Finset.sum_sub_distrib, ← Finset.sum_mul, hsum1, one_mul]
  rw [hmain]
  -- split the sum into `Smin` and its complement
  have hsplit : ∑ s, p s * (I s - c) =
      ∑ s ∈ Smin, p s * (I s - c) + ∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (I s - c) := by
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun s => s ∈ Smin)]
    congr 1
    apply Finset.sum_congr _ (fun _ _ => rfl)
    ext s; simp
  rw [hsplit]
  calc |∑ s ∈ Smin, p s * (I s - c) + ∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (I s - c)|
      ≤ |∑ s ∈ Smin, p s * (I s - c)| +
          |∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (I s - c)| := abs_add_le _ _
    _ ≤ ∑ s ∈ Smin, p s * |I s - c| +
          ∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (2 * M) := by
        gcongr with s _ s _
        · calc |∑ s ∈ Smin, p s * (I s - c)| ≤ ∑ s ∈ Smin, |p s * (I s - c)| :=
                Finset.abs_sum_le_sum_abs _ _
            _ = ∑ s ∈ Smin, p s * |I s - c| := by
                refine Finset.sum_congr rfl fun s _ => ?_
                rw [abs_mul, abs_of_nonneg (hp0 s)]
        · calc |∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (I s - c)|
              ≤ ∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), |p s * (I s - c)| :=
                Finset.abs_sum_le_sum_abs _ _
            _ ≤ ∑ s ∈ Finset.univ.filter (fun s => s ∉ Smin), p s * (2 * M) := by
                gcongr with s _
                rw [abs_mul, abs_of_nonneg (hp0 s)]
                exact mul_le_mul_of_nonneg_left (hdiff s) (hp0 s)
    _ = ∑ s ∈ Smin, p s * |I s - c|
          + 2 * M * P.real (ŝ ⁻¹' (Finset.univ.filter (fun s => s ∉ Smin) : Finset S)) := by
        rw [← Finset.sum_mul, hsum, mul_comm]

end SymbolicIV.Thm1iii

